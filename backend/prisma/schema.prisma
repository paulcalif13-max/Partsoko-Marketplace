generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  BUYER
  MECHANIC
  VALUER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Category {
  ENGINE
  TRANSMISSION
  SUSPENSION
  ELECTRICAL
  LIGHTING
  FUEL
  BODY
  ACCESSORIES
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(BUYER)
  status    String   @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  documents String[] // Array of document URLs for verification
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Seller specific
  products  Product[]
  
  // Buyer/Mechanic specific
  orders    Order[]

  // Mechanic specific
  bookings  Booking[] @relation("MechanicBookings")
  bookedBy  Booking[] @relation("UserBookings")

  // Services relations
  importRequests      ImportRequest[]
  towingRequests      TowingRequest[]
  valuationRequests   ValuationRequest[]   @relation("UserValuations")
  assignedValuations  ValuationRequest[]   @relation("ValuerJobs")
  financeApplications FinanceApplication[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String
  price         Float
  stock         Int
  category      Category    @default(OTHER)
  partNumber    String?
  brand         String?
  condition     String      @default("NEW") // NEW, REFURBISHED, USED
  images        String[]    @default([])
  compatibility Json?       // e.g. { make: "Toyota", model: "Prado", yearFrom: 2015, yearTo: 2022 }
  featured      Boolean     @default(false)
  sellerId      String
  seller        User        @relation(fields: [sellerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  commissionFee Float       @default(0) // Admin static %
  importFee     Float       @default(0) // Admin static %
  taxFee        Float       @default(0) // Admin static %
  deliveryFee   Float       @default(0)
  paymentMethod String      @default("MPESA") // MPESA, CARD, BANK
  mpesaReceipt  String?
  deliveryAddress String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // price at the time of order
}

model Booking {
  id          String   @id @default(uuid())
  mechanicId  String
  mechanic    User     @relation("MechanicBookings", fields: [mechanicId], references: [id])
  userId      String
  user        User     @relation("UserBookings", fields: [userId], references: [id])
  serviceDate DateTime
  status      String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  notes       String?
  vehicleInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportRequest {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  url             String
  vehicleMake     String?
  vehicleModel    String?
  vehicleYear     Int?
  notes           String?
  status          String   @default("RECEIVED") // RECEIVED, VERIFYING, QUOTED, PAID, ORDERED, SHIPPED, DELIVERED
  itemPriceEst    Float?
  shippingEst     Float?
  dutyEst         Float?
  serviceFee      Float?
  totalLandedCost Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TowingRequest {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  pickupLocation String
  destination    String
  vehicleReg     String
  vehicleModel   String?
  fare           Float    @default(3500)
  status         String   @default("PENDING") // PENDING, DISPATCHED, COMPLETED, CANCELLED
  providerName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ValuationRequest {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation("UserValuations", fields: [userId], references: [id])
  customerName   String?
  customerPhone  String?
  vehicleReg     String
  makeModel      String
  year           Int
  vin            String?
  location       String
  purpose        String   @default("general") // insurance, sale_purchase, financing, general
  status         String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED
  valuerId       String?
  valuer         User?    @relation("ValuerJobs", fields: [valuerId], references: [id])
  estimatedValue Float?
  reportUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinanceApplication {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  applicantName   String
  phone           String
  email           String?
  productType     String   // LOGBOOK, REPAIR, PARTS, IMPORT
  requestedAmount Float
  tenureMonths    Int      @default(12)
  vehicleData     Json?
  status          String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, DISBURSED
  partnerNotes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Settings {
  id                String @id @default("global")
  commissionPercent Float  @default(5.0)
  importTaxPercent  Float  @default(16.0)
}
